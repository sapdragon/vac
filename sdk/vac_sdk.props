<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <VacSdkRoot>$(MSBuildThisFileDirectory)</VacSdkRoot>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <WholeProgramOptimization>false</WholeProgramOptimization>

      <ExceptionHandling>false</ExceptionHandling>
      <RuntimeTypeInfo>false</RuntimeTypeInfo>
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <ControlFlowGuard>false</ControlFlowGuard>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <SDLCheck>false</SDLCheck>
      <SupportJustMyCode>false</SupportJustMyCode>
      <DebugInformationFormat>None</DebugInformationFormat>

      <AdditionalOptions>%(AdditionalOptions) /Zc:threadSafeInit- /Zc:tlsGuards- /Gs4096 /Oi /constexpr:steps33554432 /constexpr:depth1024 /utf-8</AdditionalOptions>

      <AdditionalIncludeDirectories>$(VacSdkRoot)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>

    <Link>
      <IgnoreAllDefaultLibraries>true</IgnoreAllDefaultLibraries>
      <AdditionalDependencies>kernel32.lib;user32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <SubSystem>NotSet</SubSystem>
      <NoEntryPoint>true</NoEntryPoint>
      <ForceSymbolReferences>_runfunc@20;%(ForceSymbolReferences)</ForceSymbolReferences>
      <TargetMachine>MachineX86</TargetMachine>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <LinkTimeCodeGeneration>Default</LinkTimeCodeGeneration>

      <AdditionalOptions>%(AdditionalOptions) /MERGE:.bss=.data</AdditionalOptions>
      <RandomizedBaseAddress>false</RandomizedBaseAddress>
      <FixedBaseAddress>false</FixedBaseAddress>
      <GenerateManifest>false</GenerateManifest>
      <GenerateDebugInformation>false</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

</Project>
